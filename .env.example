# ==============================================================================
# WareHouseX Enterprise Environment Configuration
# ==============================================================================

# Backend Server Configuration
WAREHOUSEX_HOST=0.0.0.0
WAREHOUSEX_PORT=5000
WAREHOUSEX_DEBUG=False
WAREHOUSEX_SECRET_KEY=whx_production_secret_key_change_in_prod_2026

# Operational Mode:
# auto - Detects Ubuntu Linux host. If Linux kernel/systemd detected, runs live scripts; else demo emulator
# live - Forces Live Ubuntu Linux integration
# demo - Runs realistic simulated Ubuntu 24.04 LTS telemetry
WAREHOUSEX_MODE=auto

# Backup Storage Path on Linux Host
WAREHOUSEX_BACKUP_DIR=/var/backups/warehousex
WAREHOUSEX_DATA_VAULT=/opt/warehousex/data

# Security & Network
WAREHOUSEX_SSH_PORT=22
WAREHOUSEX_ALLOW_ORIGINS=*
